generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code       String     @unique
  name       String
  sort_order Int        @default(0)
  created_at DateTime   @default(now()) @db.Timestamptz(6)
  menu_items MenuItem[]

  @@map("categories")
}

model MenuItem {
  id                         String                  @id
  category_id                String                  @db.Uuid
  name                       String
  price_cents                Int
  image_url                  String                  @default("")
  is_available               Boolean                 @default(true)
  sort_order                 Int                     @default(0)
  created_at                 DateTime                @default(now()) @db.Timestamptz(6)
  updated_at                 DateTime                @default(now()) @db.Timestamptz(6)
  category                   Category                @relation(fields: [category_id], references: [id], onDelete: Restrict)
  modifier_groups            MenuItemModifierGroup[]
  aliases                    MenuAlias[]
  cart_items                 CartItem[]
  resolved_actions           ChatMessageAction[]

  @@index([category_id])
  @@index([is_available])
  @@map("menu_items")
}

model ModifierGroup {
  id                         String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                       String                  @unique
  name                       String
  is_required                Boolean                 @default(false)
  min_select                 Int                     @default(0)
  max_select                 Int                     @default(1)
  created_at                 DateTime                @default(now()) @db.Timestamptz(6)
  options                    ModifierOption[]
  menu_items                 MenuItemModifierGroup[]
  cart_item_modifiers        CartItemModifier[]

  @@map("modifier_groups")
}

model ModifierOption {
  id                  String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  modifier_group_id   String             @db.Uuid
  code                String
  name                String
  price_delta_cents   Int                @default(0)
  sort_order          Int                @default(0)
  created_at          DateTime           @default(now()) @db.Timestamptz(6)
  group               ModifierGroup      @relation(fields: [modifier_group_id], references: [id], onDelete: Cascade)
  cart_item_modifiers CartItemModifier[]

  @@unique([modifier_group_id, code])
  @@index([modifier_group_id])
  @@map("modifier_options")
}

model MenuItemModifierGroup {
  menu_item_id     String
  modifier_group_id String @db.Uuid
  menu_item        MenuItem      @relation(fields: [menu_item_id], references: [id], onDelete: Cascade)
  modifier_group   ModifierGroup @relation(fields: [modifier_group_id], references: [id], onDelete: Cascade)

  @@id([menu_item_id, modifier_group_id])
  @@index([modifier_group_id])
  @@map("menu_item_modifier_groups")
}

model MenuAlias {
  alias        String
  menu_item_id String
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  menu_item    MenuItem @relation(fields: [menu_item_id], references: [id], onDelete: Cascade)

  @@id([alias, menu_item_id])
  @@index([alias])
  @@index([menu_item_id])
  @@map("menu_aliases")
}

model Cart {
  id           String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  status       String              @default("active")
  revision     Int                 @default(0)
  created_at   DateTime            @default(now()) @db.Timestamptz(6)
  updated_at   DateTime            @default(now()) @db.Timestamptz(6)
  chat_session ChatSession?
  items        CartItem[]
  actions      ChatMessageAction[]

  @@index([status])
  @@map("carts")
}

model ChatSession {
  id         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cart_id    String?       @unique @db.Uuid
  created_at DateTime      @default(now()) @db.Timestamptz(6)
  updated_at DateTime      @default(now()) @db.Timestamptz(6)
  cart       Cart?         @relation(fields: [cart_id], references: [id], onDelete: SetNull)
  messages   ChatMessage[]

  @@index([cart_id])
  @@map("chat_sessions")
}

model ChatMessage {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  chat_session_id String              @db.Uuid
  role            String
  content         String
  parsed_action   Json?
  error_type      String?
  created_at      DateTime            @default(now()) @db.Timestamptz(6)
  session         ChatSession         @relation(fields: [chat_session_id], references: [id], onDelete: Cascade)
  actions         ChatMessageAction[]
  source_items    CartItem[]

  @@index([chat_session_id])
  @@index([created_at])
  @@map("chat_messages")
}

model CartItem {
  id                            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cart_id                       String              @db.Uuid
  menu_item_id                  String
  canonical_identity            String
  quantity                      Int
  unit_price_cents              Int
  line_total_cents              Int
  note                          String?
  position                      Int
  source_chat_message_id        String?             @db.Uuid
  source_action_index           Int?
  source_chat_message_action_id String?             @db.Uuid
  created_at                    DateTime            @default(now()) @db.Timestamptz(6)
  updated_at                    DateTime            @default(now()) @db.Timestamptz(6)
  cart                          Cart                @relation(fields: [cart_id], references: [id], onDelete: Cascade)
  menu_item                     MenuItem            @relation(fields: [menu_item_id], references: [id])
  source_message                ChatMessage?        @relation(fields: [source_chat_message_id], references: [id], onDelete: SetNull)
  source_action                 ChatMessageAction?  @relation("SourceAction", fields: [source_chat_message_action_id], references: [id], onDelete: SetNull)
  resolved_actions              ChatMessageAction[] @relation("ResolvedCartItem")
  modifiers                     CartItemModifier[]

  @@unique([cart_id, position])
  @@unique([cart_id, canonical_identity])
  @@index([cart_id])
  @@index([menu_item_id])
  @@index([cart_id, position])
  @@index([cart_id, canonical_identity])
  @@map("cart_items")
}

model CartItemModifier {
  id                   String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cart_item_id         String         @db.Uuid
  modifier_group_id    String         @db.Uuid
  modifier_option_id   String         @db.Uuid
  modifier_group_code  String
  modifier_option_code String
  created_at           DateTime       @default(now()) @db.Timestamptz(6)
  cart_item            CartItem       @relation(fields: [cart_item_id], references: [id], onDelete: Cascade)
  group                ModifierGroup  @relation(fields: [modifier_group_id], references: [id])
  option               ModifierOption @relation(fields: [modifier_option_id], references: [id])

  @@unique([cart_item_id, modifier_group_id])
  @@index([cart_item_id])
  @@index([modifier_group_id])
  @@index([modifier_option_id])
  @@index([modifier_group_code])
  @@index([modifier_option_code])
  @@map("cart_item_modifiers")
}

model ChatMessageAction {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  chat_message_id         String    @db.Uuid
  cart_id                 String?   @db.Uuid
  action_index            Int
  action_type             String
  intent                  String
  status                  String
  normalized_action       Json      @default("{}")
  resolved_action         Json?
  question                String?
  message                 String?
  error_type              String?
  error_message           String?
  confidence              Decimal   @default(0) @db.Decimal(4, 3)
  depends_on              Int[]     @default([])
  reference_type          String?
  reference_action_index  Int?
  reference_cart_item_id  String?   @db.Uuid
  reference_cart_position Int?
  reference_text          String?
  resolved_menu_item_id   String?
  resolved_cart_item_id   String?   @db.Uuid
  execution_order         Int?
  executed_at             DateTime? @db.Timestamptz(6)
  created_at              DateTime  @default(now()) @db.Timestamptz(6)
  updated_at              DateTime  @default(now()) @db.Timestamptz(6)
  chat_message            ChatMessage @relation(fields: [chat_message_id], references: [id], onDelete: Cascade)
  cart                    Cart?       @relation(fields: [cart_id], references: [id], onDelete: SetNull)
  resolved_menu_item      MenuItem?   @relation(fields: [resolved_menu_item_id], references: [id], onDelete: SetNull)
  resolved_cart_item      CartItem?   @relation("ResolvedCartItem", fields: [resolved_cart_item_id], references: [id], onDelete: SetNull)
  source_items            CartItem[]  @relation("SourceAction")

  @@unique([chat_message_id, action_index])
  @@index([chat_message_id])
  @@index([cart_id])
  @@index([status])
  @@index([action_index])
  @@index([resolved_menu_item_id])
  @@index([resolved_cart_item_id])
  @@map("chat_message_actions")
}
